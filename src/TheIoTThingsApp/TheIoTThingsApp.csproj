<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Identity" Version="1.13.2" />
		<PackageReference Include="Azure.Storage.Files.DataLake" Version="12.22.0" />
		<PackageReference Include="BlazorMonaco" Version="3.3.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.3" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Identity.Web" Version="3.8.2" />
		<PackageReference Include="Microsoft.Identity.Web.UI" Version="3.8.2" />
	</ItemGroup>

	<ItemGroup>
	  <!-- Deliberately no ProjectReference to TheFlowThing/TheCounterThing/FlowUILib (or their
	       Abstractions) — every service-type plugin is loaded at runtime from plugins.json via
	       PluginLoader, never referenced at compile time. Only TheIoTThing.Abstractions (the shared
	       contract) remains. -->
	  <ProjectReference Include="..\TheIoTThing.Abstractions\TheIoTThing.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\js\" />
	</ItemGroup>

</Project>