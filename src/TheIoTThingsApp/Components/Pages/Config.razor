@page "/config/{ServiceName}"
@using BlazorMonaco.Editor
@using TheIoTThing.Abstractions
@using TheIoTThingsApp.Services
@inject ServiceOrchestrator orchestrator
@rendermode InteractiveServer

<PageTitle>Config — @ServiceName</PageTitle>

<article class="h-full flex flex-col p-4 text-gray-100">
    <h3 class="text-lg font-bold text-gray-200 mb-4 shrink-0">Config — @ServiceName</h3>

    @if (service is not null)
    {
        <div class="flex items-center gap-3 mb-4 shrink-0">
            <span class="text-xs text-gray-400">Status:</span>
            <span class="px-2 py-0.5 rounded text-xs font-bold uppercase @StatusBadgeClass">@service.Status</span>
            @if (service.Status == ServiceStatus.Running)
            {
                <button type="button" @onclick="EnterEditMode" class="px-3 py-1.5 text-xs font-medium bg-yellow-700 hover:bg-yellow-600 rounded transition">✏️ Edit (pauses the service)</button>
            }
            <button type="button" @onclick="Save" class="px-3 py-1.5 text-xs font-medium bg-blue-700 hover:bg-blue-600 rounded transition">💾 Save</button>
        </div>
    }

    @if (errorMessage is not null)
    {
        <div class="mb-3 px-3 py-2 text-xs bg-red-900/50 text-red-300 rounded shrink-0">@errorMessage</div>
    }

    @if (initialYaml is not null)
    {
        <div class="flex-1 min-h-0 border border-gray-700 rounded-lg overflow-hidden">
            <StandaloneCodeEditor @ref="_editor" ConstructionOptions="EditorConstructionOptions" CssClass="h-full" />
        </div>
    }
</article>

@code {
    [Parameter]
    public string ServiceName { get; set; } = "";

    private StandaloneCodeEditor _editor = null!;
    private string? loadedServiceName;
    private IOrchestratedService? service;
    private string? initialYaml;
    private string? configFilePath;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (ServiceName == loadedServiceName) return;
        loadedServiceName = ServiceName;

        service = await orchestrator.GetOrCreateAsync(ServiceName);
        configFilePath = ServiceStore.Resolve(ServiceName);
        var configJson = await File.ReadAllTextAsync(configFilePath);
        initialYaml = FlowYamlConverter.ToYaml(configJson);
        errorMessage = null;

        if (_editor is not null)
        {
            await _editor.SetValue(initialYaml);
        }
    }

    string StatusBadgeClass => service!.Status switch
    {
        ServiceStatus.Running => "bg-green-900/50 text-green-300",
        ServiceStatus.Paused => "bg-yellow-900/50 text-yellow-300",
        _ => "bg-gray-700 text-gray-300"
    };

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "yaml",
            Theme = "vs-dark",
            Value = initialYaml
        };
    }

    async Task EnterEditMode()
    {
        await service!.PauseAsync();
    }

    async Task Save()
    {
        errorMessage = null;
        var yaml = await _editor.GetValue();

        string configJson;
        try
        {
            configJson = FlowYamlConverter.ToJson(yaml);
        }
        catch (FlowYamlException ex)
        {
            errorMessage = ex.Message;
            return;
        }

        // Unlike the old Flow-only editor, this page serves any service type, so there's no shape to
        // deserialize-and-validate generically here — a malformed-but-syntactically-valid config still
        // surfaces as a load failure below (same as a bad flow file already did before this change).
        await service!.PauseAsync();
        await File.WriteAllTextAsync(configFilePath!, configJson);
        try
        {
            await orchestrator.ReloadAsync(ServiceName);
        }
        catch (Exception ex)
        {
            errorMessage = $"Invalid config: {ex.Message}";
        }
    }
}
