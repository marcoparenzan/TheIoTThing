@page "/"
@rendermode InteractiveServer
@using TheIoTThing.Abstractions
@using TheIoTThingsApp.Services
@inject ServiceOrchestrator orchestrator
@inject PluginRegistry pluginRegistry
@inject IJSRuntime jsRuntime
@inject NavigationManager navigationManager
@implements IDisposable

<PageTitle>Home</PageTitle>

<article class="p-4">
    <h3 class="text-lg font-bold text-gray-200 mb-4">Services</h3>

    <div class="flex items-center gap-2 mb-4 max-w-3xl">
        <input type="text" @bind="newServiceName" @bind:event="oninput" @onkeydown="OnNewServiceKeyDown" placeholder="new-service-name" class="px-2 py-1.5 text-xs bg-gray-800 border border-gray-600 rounded focus:outline-none focus:border-blue-500 text-gray-100" />
        <select @bind="newServiceType" class="px-2 py-1.5 text-xs bg-gray-800 border border-gray-600 rounded focus:outline-none focus:border-blue-500 text-gray-100">
            @foreach (var type in pluginRegistry.Types)
            {
                <option value="@type">@type</option>
            }
        </select>
        <button type="button" @onclick="CreateService" class="px-3 py-1.5 text-xs font-medium bg-blue-700 hover:bg-blue-600 rounded transition">+ New Service</button>
    </div>

    @if (createError is not null)
    {
        <div class="mb-4 px-3 py-2 text-xs bg-red-900/50 text-red-300 rounded max-w-3xl">@createError</div>
    }

    @if (services is null)
    {
        <p class="text-sm text-gray-400">Loading...</p>
    }
    else if (services.Count == 0)
    {
        <p class="text-sm text-gray-400">No services found in <code class="text-gray-300">@ServiceStore.ServicesDirectory</code>.</p>
    }
    else
    {
        <table class="w-full text-sm border-collapse max-w-3xl">
            <thead>
                <tr class="text-left text-gray-400 border-b border-gray-700">
                    <th class="py-2 pr-4 font-semibold">Name</th>
                    <th class="py-2 pr-4 font-semibold">Type</th>
                    <th class="py-2 pr-4 font-semibold">Status</th>
                    <th class="py-2 pr-4 font-semibold">Actions</th>
                    <th class="py-2 pr-4 font-semibold">Autostart</th>
                    <th class="py-2 pr-4 font-semibold">Edit</th>
                    <th class="py-2 pr-4 font-semibold"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var service in services)
                {
                    <tr class="border-b border-gray-800">
                        <td class="py-2 pr-4 font-mono text-gray-200">@service.Name</td>
                        <td class="py-2 pr-4 text-gray-400">@service.Type</td>
                        <td class="py-2 pr-4">
                            <span class="px-2 py-0.5 rounded text-xs font-bold uppercase @StatusBadgeClass(service.Status)">@service.Status</span>
                        </td>
                        <td class="py-2 pr-4">
                            <div class="flex items-center gap-1">
                                <button type="button" @onclick="() => Start(service.Name)" disabled="@(service.Status == ServiceStatus.Running)" class="px-2 py-1 text-xs font-medium bg-green-700 hover:bg-green-600 disabled:opacity-40 disabled:cursor-not-allowed rounded transition" title="Start">▶</button>
                                <button type="button" @onclick="() => Pause(service.Name)" disabled="@(service.Status != ServiceStatus.Running)" class="px-2 py-1 text-xs font-medium bg-yellow-700 hover:bg-yellow-600 disabled:opacity-40 disabled:cursor-not-allowed rounded transition" title="Pause">⏸</button>
                                <button type="button" @onclick="() => Stop(service.Name)" disabled="@(service.Status == ServiceStatus.Stopped)" class="px-2 py-1 text-xs font-medium bg-red-800 hover:bg-red-700 disabled:opacity-40 disabled:cursor-not-allowed rounded transition" title="Stop">⏹</button>
                            </div>
                        </td>
                        <td class="py-2 pr-4">
                            <input type="checkbox" checked="@service.Autostart" @onchange="e => ToggleAutostart(service.Name, e)" class="w-4 h-4" title="Start automatically when the application launches" />
                        </td>
                        <td class="py-2 pr-4">
                            @{
                                var specificRoute = pluginRegistry.TryGetEditRoute(service.Type, service.Name);
                            }
                            @if (specificRoute is not null)
                            {
                                <a href="@specificRoute" class="text-blue-400 hover:underline mr-3">Visual</a>
                            }
                            <a href="@($"/config/{Uri.EscapeDataString(service.Name)}")" class="text-blue-400 hover:underline">Config</a>
                        </td>
                        <td class="py-2 pr-4">
                            <button type="button" @onclick="() => DeleteService(service.Name)" class="px-2 py-1 text-xs font-medium bg-red-900/50 hover:bg-red-800/60 text-red-300 rounded transition" title="Delete">🗑</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</article>

@code {
    IReadOnlyCollection<ServiceInfo>? services;
    Timer? refreshTimer;
    string newServiceName = "";
    string newServiceType = "flow";
    string? createError;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        refreshTimer = new Timer(OnTimerTick, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    void OnTimerTick(object? state) => _ = InvokeAsync(async () =>
    {
        await Refresh();
        StateHasChanged();
    });

    async Task Refresh()
    {
        services = await orchestrator.GetAllAsync();
    }

    static string StatusBadgeClass(ServiceStatus status) => status switch
    {
        ServiceStatus.Running => "bg-green-900/50 text-green-300",
        ServiceStatus.Paused => "bg-yellow-900/50 text-yellow-300",
        _ => "bg-gray-700 text-gray-300"
    };

    async Task Start(string name)
    {
        var service = await orchestrator.GetOrCreateAsync(name);
        await service.StartAsync();
        await Refresh();
    }

    async Task Pause(string name)
    {
        var service = await orchestrator.GetOrCreateAsync(name);
        await service.PauseAsync();
        await Refresh();
    }

    async Task Stop(string name)
    {
        var service = await orchestrator.GetOrCreateAsync(name);
        await service.StopAsync();
        await Refresh();
    }

    async Task ToggleAutostart(string name, ChangeEventArgs e)
    {
        var value = e.Value is bool b && b;
        await orchestrator.SetAutostartAsync(name, value);
        await Refresh();
    }

    async Task OnNewServiceKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CreateService();
        }
    }

    async Task CreateService()
    {
        createError = null;
        try
        {
            var fileName = await orchestrator.CreateAsync(newServiceName, newServiceType);
            var editRoute = pluginRegistry.TryGetEditRoute(newServiceType, fileName) ?? $"/config/{Uri.EscapeDataString(fileName)}";
            navigationManager.NavigateTo(editRoute);
        }
        catch (Exception ex)
        {
            createError = ex.Message;
        }
    }

    async Task DeleteService(string name)
    {
        var confirmed = await jsRuntime.InvokeAsync<bool>("confirm", $"Delete service '{name}'? This cannot be undone.");
        if (!confirmed) return;

        await orchestrator.DeleteAsync(name);
        await Refresh();
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
