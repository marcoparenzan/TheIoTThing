@inherits LayoutComponentBase

<div class="flex h-screen w-screen overflow-hidden bg-gray-900 text-gray-100 font-sans">
    <aside class="@(_drawerOpen ? "w-56" : "w-0") transition-all duration-200 overflow-hidden bg-gray-950 border-r border-gray-800 shrink-0" style="background:#111827">
        <div class="h-14 flex items-center px-4 border-b border-gray-800 whitespace-nowrap">
            <span class="text-lg font-bold text-blue-400 mr-2">⬡</span>
            <span class="text-sm font-bold tracking-wide text-gray-200">The IoT Thing</span>
        </div>
        <NavMenu />
    </aside>

    <div class="flex flex-1 flex-col min-w-0">
        <header class="h-14 flex items-center gap-3 px-4 bg-gray-800 border-b border-gray-700 shrink-0">
            <button type="button" @onclick="DrawerToggle" class="p-2 rounded hover:bg-gray-700 transition text-gray-300" title="Menu">
                ☰
            </button>
        </header>

        <main class="flex-1 overflow-auto">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-0 inset-x-0 bg-red-900/90 text-red-100 text-sm px-4 py-3 flex items-center justify-between z-50">
    <span>An unhandled error has occurred.</span>
    <div class="flex items-center gap-3">
        <a href="" class="underline">Reload</a>
        <a class="cursor-pointer">🗙</a>
    </div>
</div>

@code {
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
